# Copy to web/.env.profile.prod and fill in real values (gitignored).
# Used by: pnpm run backend:prod, pnpm run backend:link, pnpm run backend:pull-prod-data
#
# Also copy VITE_* / Cloudinary / CF vars from web/.env.example or your current prod web/.env.

# Cloudflare Pages — `pnpm run frontend:prod` (optional if you already ran `wrangler login` on this machine)
# CF_PAGES_PROJECT_NAME=your-pages-project
# CLOUDFLARE_API_TOKEN=...   # API token with Cloudflare Pages deploy; avoids interactive login in CI/IDE
# CLOUDFLARE_ACCOUNT_ID=...  # Workers & Pages → select account → Account ID (right sidebar); needed if token is Pages-only and whoami fails)
# CF_WRANGLER_WHOAMI_TIMEOUT_SECONDS=90   # optional; abort if wrangler whoami hangs (default 90)

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase CLI — same account as the production project above.
# Dashboard → Account → Access Tokens
SUPABASE_ACCESS_TOKEN=your_supabase_access_token
# Dashboard → Project Settings → General → Reference ID
SUPABASE_PROJECT_REF=your_supabase_project_ref


