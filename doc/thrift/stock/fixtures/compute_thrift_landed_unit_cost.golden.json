          "product_weight": 500,
          "extra_weight": 0,
          "origin_unit_price": 200,
          "extra_origin_unit_price": 0,
          "additional_charges_cost": 0
        },
        {
          "id": 2,
          "quantity": 1,
          "product_weight": 1500,
          "extra_weight": 0,
          "origin_unit_price": 300,
          "extra_origin_unit_price": 0,
          "additional_charges_cost": 20
