    {
      "id": "weight_cargo_basic",
      "description": "Weight-based cargo share with markup",
      "settings": {
        "hand_tag_unit_cost": 10,
        "sticker_unit_cost": 5
      },
      "shipment": {
        "product_conversion_rate": 1,
        "cargo_conversion_rate": 1,
        "cargo_rate": 100,
        "total_cargo_weight_kg": 10,
        "labor_total_cost": 100,
        "transportation_total_cost": 50,
        "washing_total_cost": 50,
        "default_markup_rate": 0.5
