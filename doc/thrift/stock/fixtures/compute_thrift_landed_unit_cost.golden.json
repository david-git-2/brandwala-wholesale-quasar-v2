      "pricing_by_stock_id": {
        "1": {
          "listed_unit_price": 0,
          "is_listed_price_manual": false,
          "markup_rate_override": null
        },
        "2": {
          "listed_unit_price": 0,
          "is_listed_price_manual": false,
          "markup_rate_override": null
        }
      },
      "expect_by_stock_id": {
        "1": {
          "landed_unit_cost": 565,
          "uses_weight_based_cargo": true,
          "cargo_share_per_unit": 250,
          "suggested_sell_unit_price": 850
