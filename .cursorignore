# Dependencies
node_modules/
web/node_modules/

# Python virtualenv (python/ source stays indexed)
.venv/
python/.venv/

# Quasar / Vite build output
web/.quasar/
web/dist/
**/.cache/
**/*.tsbuildinfo
**/.eslintcache
web/quasar.config.*.temporary.compiled*

# Supabase local cache
supabase/.temp/

# Python caches and large dirs
python/__pycache__/
python/.ipynb_checkpoints/
python/images/
python/credentials/
python/data/
**/*.xlsx

# Catalog dumps & static data (not app logic)
web/public/uk/
web/src/data/bd_address/*.json

# Lockfiles
pnpm-lock.yaml
**/package-lock.json
**/*.lock

# Schema dump leftovers & archives (not live SQL)
supabase/.dumps/
supabase/_domain_splits_archive/
supabase/schemas/*.bak
supabase/schemas/*.pre-so3

# Logs and backups
**/*.log
backups/
**/*.ndjson
**/*.json.gz

# OS
.DS_Store
